<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/captureTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/key_capture_title"
        android:textSize="22sp"
        android:textAlignment="center"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/captureStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/press_your_switch"
        android:textColor="@color/design_default_color_error"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/captureCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="10dp"
        android:minHeight="48dp"
        android:minWidth="88dp"
        android:background="@drawable/custom_binding_linear"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:textColor="#000"
        android:textSize="16sp" />

</LinearLayout>
