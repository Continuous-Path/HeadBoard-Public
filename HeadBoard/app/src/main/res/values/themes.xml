<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light">
        <item name="android:buttonStyle">@style/MyButtonStyle</item>
        <item name="android:textColor">#202124</item>
        <item name="colorPrimary">@color/white</item>
    </style>

    <style name="MyButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Dialog theme: undoes AppTheme's white-on-grey global button style, which renders
         dialog buttons invisible, and provides the alert min-width so plain Dialogs
         don't collapse to wrap_content. -->
    <style name="HeadBoardDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:buttonStyle">@style/HeadBoardDialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/HeadBoardDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/HeadBoardDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/HeadBoardDialogButton</item>
        <item name="colorAccent">#0B57D0</item>
        <item name="android:textColor">#202124</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>

    <style name="HeadBoardDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#0B57D0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MySwitch" parent="Theme.AppCompat.Light">
        <!-- active thumb & track color (30% transparency) -->
        <item name="colorControlActivated">@color/blue</item>

        <!-- inactive thumb color -->
        <item name="colorSwitchThumbNormal">#f1f1f1
        </item>

        <!-- inactive track color (30% transparency) -->
        <item name="android:colorForeground">#42221f1f
        </item>
    </style>


    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/headboard_face_splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
    </style>


</resources>